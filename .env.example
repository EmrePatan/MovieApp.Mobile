# MovieApp Mobile environment configuration
# Copy this file to `.env` for local development.
# Never commit `.env` files with real secrets or production credentials.

# App environment: development | preview | production
# Defaults to development when unset.
EXPO_PUBLIC_APP_ENV=development

# Backend API base URL (no trailing slash)
# Development examples:
#   Android emulator -> http://10.0.2.2:5027
#   iOS simulator / local machine -> http://localhost:5027
#   Physical device on LAN -> http://192.168.x.x:5027
EXPO_PUBLIC_API_URL=http://localhost:5027

# Production builds must set a public HTTPS API URL through EAS environment
# variables for the production profile. Do not use localhost or private LAN IPs.
# Example placeholder only — replace with your deployed API URL before release:
# EXPO_PUBLIC_API_URL=https://your-production-api.example.com

# Optional image base URL for backend-relative poster/backdrop/still paths.
# The backend contract does not define a CDN base URL.
# When unset, relative image paths show placeholders.
# EXPO_PUBLIC_IMAGE_BASE_URL=
