# MovieApp Mobile environment configuration
# Copy this file to `.env` for local development.
# Never commit `.env` files with real secrets or production credentials.

# App environment: development | preview | production
# Defaults to development when unset.
EXPO_PUBLIC_APP_ENV=development

# Backend API base URL (no trailing slash)
# Development examples:
#   Android emulator -> http://10.0.2.2:5027
#   iOS simulator / local machine -> http://localhost:5027
#   Physical device on LAN -> http://192.168.x.x:5027
EXPO_PUBLIC_API_URL=http://localhost:5027

# Production / preview builds: set these in the Expo dashboard (EAS environment
# variables) for each build profile. Do not commit real values to git.
#
# Required for production store builds:
#   EXPO_PUBLIC_API_URL=https://api.<your-public-domain>
#   EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=<google-web-oauth-client-id>
#   EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=<google-ios-oauth-client-id>
#
# EXPO_PUBLIC_APP_ENV is set per profile in eas.json (development/preview/production).
# Do not use localhost or private LAN IPs in production/preview profiles.

# Google Sign-In client IDs (from Google Cloud Console OAuth clients)
# EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=<google-web-client-id>
# EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=<google-ios-client-id>

# Optional image base URL override for backend-relative TMDB image paths.
# When unset, the app defaults to https://image.tmdb.org/t/p.
# TMDB image base. Both forms work; size is applied exactly once at resolve time.
# EXPO_PUBLIC_IMAGE_BASE_URL=https://image.tmdb.org/t/p
# EXPO_PUBLIC_IMAGE_BASE_URL=https://image.tmdb.org/t/p/w500
